# Copy to .env (git-ignored) for local development.
PORT=3001
WEB_APP_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://contact_management:contact_management@localhost:5432/contact_management"

# --- Logging ---
# LOG_LEVEL: verbose | debug | info | warn | error  (default: debug)
LOG_LEVEL=debug
# LOG_FORMAT=json prints one JSON object per line (use in containers)
# LOG_FORMAT=json

# --- OpenTelemetry ---
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to keep logs on stdout only. Set it
# to an OTLP/HTTP collector (e.g. http://localhost:4318) to export traces and logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=contact-management-api
# OTEL_SDK_DISABLED=true

# --- Swagger UI at /docs (default: on, except NODE_ENV=production) ---
# SWAGGER_ENABLED=true
