{
  "name": "contact-management",
  "version": "1.0.0",
  "private": true,
  "description": "ניהול גופים נתמכים ואנשי קשר",
  "homepage": "https://github.com/meanochi/contact-management#readme",
  "bugs": {
    "url": "https://github.com/meanochi/contact-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meanochi/contact-management.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "predev": "npm run db:migrate:deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate --workspace=@contact-management/db",
    "db:migrate": "npm run db:migrate --workspace=@contact-management/db",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@contact-management/db"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9"
  }
}
