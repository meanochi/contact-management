  "devDependencies": {
    "@contact-management/config": "*",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "tsx": "4.23.15"
  }
